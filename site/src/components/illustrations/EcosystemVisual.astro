    <rect x="346" y="62" width="26" height="26" rx="7" />
    <rect x="66" y="232" width="26" height="26" rx="7" />
    <rect x="366" y="232" width="26" height="26" rx="7" />
  </g>

  <!-- account centrale -->
  <circle cx="240" cy="170" r="46" class="fill-accent" />
  <g class="fill-accent-contrast">
    <circle cx="240" cy="156" r="14" />
    <path d="M212 196 a28 22 0 0 1 56 0 z" />
  </g>
</svg>
