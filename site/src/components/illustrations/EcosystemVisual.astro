    <rect x="70" y="46" width="80" height="66" rx="12" />
    <rect x="330" y="46" width="80" height="66" rx="12" />
    <rect x="50" y="216" width="80" height="66" rx="12" />
    <rect x="350" y="216" width="80" height="66" rx="12" />
