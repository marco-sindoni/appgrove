  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="8" y="8" width="464" height="324" rx="20" class="fill-surface-2 stroke-line" stroke-width="1.5" />

  <!-- connessioni -->
  <g class="stroke-accent" stroke-width="2.5" opacity="0.6">
    <line x1="240" y1="170" x2="110" y2="80" />
