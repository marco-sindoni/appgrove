---
// Illustrazione privacy/EU (UC 0037): scudo con spunta + arco di stelle europee.
// On-brand, tema chiaro/scuro. Decorativa: aria-hidden.
---

<svg
  viewBox="0 0 480 340"
  class="ag-illustration h-auto w-full"
  data-illustration="privacy"
  role="presentation"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="8" y="8" width="464" height="324" rx="20" class="fill-surface-2 stroke-line" stroke-width="1.5" />

  <!-- scudo -->
  <path
    d="M240 60 l120 40 v70 c0 78 -54 118 -120 140 c-66 -22 -120 -62 -120 -140 v-70 z"
    class="fill-surface stroke-line"
    stroke-width="2"
  />
  <path
    d="M240 84 l96 32 v58 c0 63 -43 96 -96 114 c-53 -18 -96 -51 -96 -114 v-58 z"
    class="fill-accent"
    opacity="0.16"
  />

  <!-- spunta -->
  <path
    d="M198 178 l30 30 l58 -66"
    fill="none"
    class="stroke-accent"
    stroke-width="12"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- arco di stelle (UE) -->
  <g class="fill-accent">
    <circle cx="240" cy="52" r="6" />
    <circle cx="300" cy="60" r="6" />
    <circle cx="348" cy="96" r="6" />
    <circle cx="180" cy="60" r="6" />
    <circle cx="132" cy="96" r="6" />
  </g>
</svg>
