---
// Illustrazione "Ready for AI" (UC 0037): una chat dell'assistente AI collegata a
// un'app appgrove (visione MCP). On-brand, tema chiaro/scuro. Decorativa: aria-hidden.
---

<svg
  viewBox="0 0 480 340"
  class="ag-illustration h-auto w-full"
  data-illustration="ai"
  role="presentation"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="8" y="8" width="464" height="324" rx="20" class="fill-surface-2 stroke-line" stroke-width="1.5" />

  <!-- finestra chat (sinistra) -->
  <rect x="36" y="60" width="190" height="220" rx="14" class="fill-surface stroke-line" stroke-width="1.5" />
  <g class="fill-surface-3">
    <rect x="56" y="86" width="120" height="26" rx="13" />
    <rect x="86" y="124" width="120" height="26" rx="13" />
  </g>
  <!-- bolla di risposta (accento) -->
  <rect x="56" y="162" width="150" height="34" rx="13" class="fill-accent" />
  <rect x="70" y="175" width="96" height="8" rx="4" class="fill-accent-contrast" opacity="0.85" />
  <!-- campo di input -->
  <rect x="56" y="236" width="150" height="24" rx="12" class="fill-surface-2 stroke-line" stroke-width="1.5" />

  <!-- connettore MCP -->
  <g class="stroke-accent" stroke-width="3" stroke-linecap="round">
    <line x1="226" y1="170" x2="292" y2="170" />
  </g>
  <circle cx="238" cy="170" r="6" class="fill-accent" />
  <circle cx="280" cy="170" r="6" class="fill-accent" />
  <circle cx="259" cy="170" r="7" class="fill-surface stroke-accent" stroke-width="3" />

  <!-- finestra app (destra) -->
  <rect x="292" y="60" width="152" height="220" rx="14" class="fill-surface stroke-line" stroke-width="1.5" />
  <path d="M292 78 a14 14 0 0 1 14 -14 h124 a14 14 0 0 1 14 14 v14 h-152 z" class="fill-surface-2" />
  <rect x="312" y="112" width="40" height="40" rx="10" class="fill-accent" />
  <g class="fill-line">
    <rect x="312" y="170" width="112" height="10" rx="5" />
    <rect x="312" y="192" width="88" height="10" rx="5" />
    <rect x="312" y="214" width="100" height="10" rx="5" />
  </g>
</svg>
