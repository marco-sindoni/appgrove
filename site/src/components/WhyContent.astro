---
// Corpo della pagina "Perché appgrove" (UC 0037), estratto da [lang]/why.astro quando
// la pagina è passata al dispatcher [lang]/[slug].astro per avere slug localizzati
// (UC 0040). Mission e valori sui quattro pilastri (tempo · ecosistema · Ready for AI
// · privacy EU). NESSUNA founder story (#14 24). Contenuti dal modello marketing.
import type { Locale } from '../lib/i18n.ts'
import { MARKETING } from '../content/marketing/index.ts'
import { APP_SIGNUP } from '../lib/links.ts'
import FaqSection from './FaqSection.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = MARKETING[lang]
---

<section class="py-8">
  <h1 class="text-4xl font-extrabold tracking-tight">{t.why.title}</h1>
  <p class="mt-4 max-w-2xl text-lg text-fg-muted">{t.why.intro}</p>
</section>

<div class="grid gap-6 sm:grid-cols-2">
  {
    t.why.sections.map((s) => (
      <section class="rounded-lg border border-line bg-surface p-6">
        <h2 class="text-xl font-bold tracking-tight">{s.title}</h2>
        <p class="mt-2 text-fg-muted">{s.body}</p>
      </section>
    ))
  }
</div>

{/* FAQ della pagina "perché" — contenuto machine-readable + FAQPage JSON-LD (UC 0041, GEO) */}
<FaqSection faq={t.why.faq} />

<section class="mt-12 border-t border-line py-10">
  <a
    href={APP_SIGNUP}
    class="rounded-pill bg-accent px-5 py-2.5 font-semibold text-accent-contrast hover:opacity-90"
  >
    {t.finalCta.primary}
  </a>
</section>
