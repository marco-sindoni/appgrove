---
// Template parametrico della landing per-app (UC 0038): le 8 sezioni (#14 25) rese
// on-brand (design system UC 0019), responsive, light/dark, screenshot-first, con
// icone Material Symbols nelle feature. Parametrico su LandingLocaleContent: nessun
// testo cablato qui — tutto arriva dal contenuto per lingua.
//
// Import del font icone SOLO qui: Astro lo lega alle pagine che usano il template,
// non a tutto il sito (le altre pagine restano leggere).
import 'material-symbols/outlined.css'
import type { LandingLocaleContent } from '../content/landings/types.ts'
import type { Locale } from '../lib/i18n.ts'
import { APP_SIGNUP } from '../lib/links.ts'
import { brandHref } from '../lib/routes.ts'

interface Props {
  content: LandingLocaleContent
  lang: Locale
}

const { content: c, lang } = Astro.props
---

<div class="landing">
  {/* (1) Hero — headline job-led + sotto-beneficio + CTA + screenshot */}
  <section class="grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-2">
    <div>
      <p class="mb-4 inline-flex rounded-pill border border-line bg-surface-2 px-3 py-1 text-xs font-semibold text-fg-muted">
        {c.hero.badge}
      </p>
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl">{c.hero.title}</h1>
      <p class="max-w-xl text-lg text-fg-muted">{c.hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={APP_SIGNUP}
          class="rounded-pill bg-accent px-5 py-2.5 font-semibold text-accent-contrast hover:opacity-90"
        >
          {c.hero.ctaPrimary}
        </a>
        <a
          href="#how-it-works"
          class="rounded-pill border border-line px-5 py-2.5 font-semibold hover:bg-surface-2"
        >
          {c.hero.ctaSecondary}
        </a>
      </div>
    </div>
    {
      c.hero.screenshot.src ? (
        <img
          src={c.hero.screenshot.src}
          alt={c.hero.screenshot.alt}
          class="w-full rounded-xl border border-line shadow-lg"
          loading="eager"
        />
      ) : (
        <div
          class="flex aspect-[16/10] w-full items-center justify-center rounded-xl border border-dashed border-line bg-surface-2 text-fg-faint"
          role="img"
          aria-label={c.hero.screenshot.alt}
        >
          <span class="material-symbols-outlined text-5xl" aria-hidden="true">image</span>
        </div>
      )
    }
  </section>

  {/* (2) Problema → soluzione */}
  <section class="border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{c.problemSolution.title}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border border-line bg-surface p-6">
        <p class="text-fg-muted">{c.problemSolution.problem}</p>
      </div>
      <div class="rounded-lg border border-line bg-surface-2 p-6">
        <p class="font-medium">{c.problemSolution.solution}</p>
      </div>
    </div>
  </section>

  {/* (3) Feature chiave (3–6) — icone Material Symbols */}
  <section class="border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{c.features.title}</h2>
    <p class="mt-2 max-w-2xl text-fg-muted">{c.features.subtitle}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        c.features.items.map((f) => (
          <article class="rounded-lg border border-line bg-surface p-5">
            <span class="material-symbols-outlined text-3xl text-accent" aria-hidden="true">
              {f.icon}
            </span>
            <h3 class="mt-3 text-lg font-semibold">{f.title}</h3>
            <p class="mt-1 text-sm text-fg-muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* (4) Come funziona (2–3 step) */}
  <section id="how-it-works" class="scroll-mt-20 border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{c.howItWorks.title}</h2>
    <ol class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        c.howItWorks.steps.map((s, i) => (
          <li class="rounded-lg border border-line bg-surface p-5">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-pill bg-accent font-bold text-accent-contrast">
              {i + 1}
            </span>
            <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
            <p class="mt-1 text-sm text-fg-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* (5) Pricing/tier — mensile/annuale (default annuale) + prova */}
  <section class="border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{c.pricing.title}</h2>
    <p class="mt-2 max-w-2xl text-fg-muted">{c.pricing.subtitle}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        c.pricing.tiers.map((tier) => (
          <article
            class:list={[
              'rounded-lg border p-6',
              tier.highlighted ? 'border-accent bg-surface-2' : 'border-line bg-surface',
            ]}
          >
            <h3 class="text-lg font-semibold">{tier.name}</h3>
            <p class="mt-2 text-2xl font-extrabold tracking-tight">
              {tier.priceYearly}
              <span class="ml-1 align-middle text-xs font-medium text-fg-muted">
                {c.pricing.yearlyLabel}
              </span>
            </p>
            <p class="text-sm text-fg-muted">
              {tier.priceMonthly} · {c.pricing.monthlyLabel}
            </p>
            <ul class="mt-4 flex flex-col gap-2 text-sm">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-base text-accent" aria-hidden="true">
                    check
                  </span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-fg-faint">{c.pricing.trialNote}</p>
  </section>

  {/* (6) Badge/sezione privacy EU — firma di fiducia */}
  <section class="border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{c.privacy.title}</h2>
    <p class="mt-2 max-w-2xl text-fg-muted">{c.privacy.body}</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        c.privacy.points.map((p) => (
          <li class="flex items-center gap-2 rounded-md border border-line bg-surface-2 px-4 py-3 text-sm">
            <span class="material-symbols-outlined text-base text-accent" aria-hidden="true">shield</span>
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* (7) FAQ */}
  <section class="border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{c.faq.title}</h2>
    <dl class="mt-6 flex flex-col gap-3">
      {
        c.faq.items.map((item) => (
          <div class="rounded-lg border border-line bg-surface p-5">
            <dt class="font-semibold">{item.q}</dt>
            <dd class="mt-1 text-sm text-fg-muted">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* (8) CTA finale */}
  <section class="border-t border-line py-14">
    <h2 class="text-2xl font-bold tracking-tight">{c.finalCta.title}</h2>
    <p class="mt-2 max-w-2xl text-fg-muted">{c.finalCta.body}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={APP_SIGNUP}
        class="rounded-pill bg-accent px-5 py-2.5 font-semibold text-accent-contrast hover:opacity-90"
      >
        {c.finalCta.primary}
      </a>
      <a
        href={brandHref('why', lang)}
        class="rounded-pill border border-line px-5 py-2.5 font-semibold hover:bg-surface-2"
      >
        {c.finalCta.secondary}
      </a>
    </div>
  </section>
</div>
