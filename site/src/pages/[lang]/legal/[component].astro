---
// Documenti legali per lingua (UC 0036): renderizzati da content/legal/*.md con
// i token del titolare risolti da entity.yaml. Solo i contenuti `published`
// finiscono in output (gate #14 52) via publishedLegalPaths().
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { loadLegalDoc, publishedLegalPaths, type LegalComponent } from '../../../lib/legal.ts'
import type { Locale } from '../../../lib/i18n.ts'

export function getStaticPaths() {
  return publishedLegalPaths().map(({ component, lang }) => ({
    params: { lang, component },
  }))
}

const lang = Astro.params.lang as Locale
const component = Astro.params.component as LegalComponent
const doc = loadLegalDoc(component, lang)

const titles: Record<string, string> = {
  privacy: 'Privacy Policy',
  terms: 'Terms & Conditions',
  refund: 'Refund Policy',
  cookie: 'Cookie',
  subprocessors: 'Sub-processors',
}

// Meta description dei legali (UC 0040): breve, localizzata, per non lasciare pagine
// indicizzabili senza descrizione. I documenti .md non portano una description propria.
const legalDescription: Record<Locale, string> = {
  en: 'Legal document for appgrove — your data and your rights, hosted in the EU with full GDPR protection.',
  it: 'Documento legale di appgrove — i tuoi dati e i tuoi diritti, ospitati in UE con piena tutela GDPR.',
  fr: 'Document légal appgrove — vos données et vos droits, hébergés dans l’UE avec pleine protection RGPD.',
  es: 'Documento legal de appgrove — tus datos y tus derechos, alojados en la UE con plena protección RGPD.',
  de: 'Rechtsdokument von appgrove — deine Daten und Rechte, in der EU gehostet mit vollem DSGVO-Schutz.',
}
---

<BaseLayout
  lang={lang}
  title={titles[component] ?? component}
  description={legalDescription[lang]}
  pathWithinLocale={`/legal/${component}/`}
>
  <article class="prose-legal">
    <p class="mb-6 text-sm text-fg-faint">
      v{doc.frontmatter.version} · {doc.frontmatter.effective_date}
    </p>
    <div set:html={doc.html} />
  </article>
</BaseLayout>
