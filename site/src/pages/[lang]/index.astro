---
// Homepage per lingua (UC 0037). Sequenza narrativa (#14 26) estesa col pilastro
// AI: hero → vetrina app (onesta col catalogo piccolo) → cross-sell → Ready for AI
// → privacy/EU → newsletter → CTA finale. Contenuti dal modello marketing per lingua.
// Illustrazioni vettoriali on-brand per sezione (change 0048, #14 F3): SVG che
// seguono accento e tema chiaro/scuro tramite i token del design system, decorative.
import BaseLayout from '../../layouts/BaseLayout.astro'
import { LOCALES, type Locale } from '../../lib/i18n.ts'
import { MARKETING } from '../../content/marketing/index.ts'
import { APP_SIGNUP } from '../../lib/links.ts'
import { brandHref } from '../../lib/routes.ts'
import { faqPageJsonLd } from '../../lib/seo.ts'
import FaqSection from '../../components/FaqSection.astro'
import HeroVisual from '../../components/illustrations/HeroVisual.astro'
import AppsVisual from '../../components/illustrations/AppsVisual.astro'
import EcosystemVisual from '../../components/illustrations/EcosystemVisual.astro'
import AiVisual from '../../components/illustrations/AiVisual.astro'
import PrivacyVisual from '../../components/illustrations/PrivacyVisual.astro'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Locale
const t = MARKETING[lang]

// Dato strutturato FAQPage della homepage (UC 0041, GEO): la FAQ generale di marca.
const jsonLd = faqPageJsonLd(t.faq.items)
---

<BaseLayout lang={lang} title="appgrove" description={t.hero.subtitle} jsonLd={jsonLd}>
  {/* Hero */}
  <section class="grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-2">
    <div>
      <p class="mb-4 inline-flex rounded-pill border border-line bg-surface-2 px-3 py-1 text-xs font-semibold text-fg-muted">
        {t.hero.badge}
      </p>
      <h1 class="mb-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{t.hero.title}</h1>
      <p class="max-w-2xl text-lg text-fg-muted">{t.hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={APP_SIGNUP}
          class="rounded-pill bg-accent px-5 py-2.5 font-semibold text-accent-contrast hover:opacity-90"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#apps"
          class="rounded-pill border border-line px-5 py-2.5 font-semibold hover:bg-surface-2"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>
    <HeroVisual />
  </section>

  {/* Vetrina app — onesta col catalogo piccolo (#14 11/26) */}
  <section id="apps" class="scroll-mt-20 border-t border-line py-12">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">{t.apps.title}</h2>
        <p class="mt-2 max-w-2xl text-fg-muted">{t.apps.subtitle}</p>
      </div>
      <AppsVisual />
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <article class="rounded-lg border border-line bg-surface p-5">
        <div class="mb-2 flex items-center gap-2">
          <h3 class="text-lg font-semibold">{t.apps.flagshipName}</h3>
          <span class="rounded-pill bg-surface-2 px-2 py-0.5 text-xs font-semibold text-fg-muted">
            {t.apps.comingSoon}
          </span>
        </div>
        <p class="text-sm font-medium text-fg-muted">{t.apps.flagshipCategory}</p>
        <p class="mt-2 text-sm text-fg-muted">{t.apps.flagshipDescription}</p>
      </article>
      <article class="rounded-lg border border-dashed border-line p-5">
        <h3 class="text-lg font-semibold">{t.apps.moreTitle}</h3>
        <p class="mt-2 text-sm text-fg-muted">{t.apps.moreText}</p>
      </article>
    </div>
  </section>

  {/* Cross-sell: un account, tanti strumenti */}
  <section class="border-t border-line py-12">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <EcosystemVisual />
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="text-2xl font-bold tracking-tight">{t.crossSell.title}</h2>
        <p class="mt-2 max-w-2xl text-fg-muted">{t.crossSell.body}</p>
        <ul class="mt-6 grid gap-3">
          {
            t.crossSell.points.map((p) => (
              <li class="rounded-md border border-line bg-surface-2 px-4 py-3 text-sm">{p}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Ready for AI — cuneo differenziante, inquadramento visione (onesto) */}
  <section class="border-t border-line py-12">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">{t.ai.title}</h2>
        <p class="mt-2 max-w-2xl text-fg-muted">{t.ai.body}</p>
        <ul class="mt-6 grid gap-3">
          {
            t.ai.points.map((p) => (
              <li class="rounded-md border border-line bg-surface-2 px-4 py-3 text-sm">{p}</li>
            ))
          }
        </ul>
        {t.ai.note && <p class="mt-4 text-sm text-fg-faint">{t.ai.note}</p>}
      </div>
      <AiVisual />
    </div>
  </section>

  {/* Privacy/EU — firma di fiducia, non headline (#14 E7) */}
  <section class="border-t border-line py-12">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <PrivacyVisual />
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="text-2xl font-bold tracking-tight">{t.privacy.title}</h2>
        <p class="mt-2 max-w-2xl text-fg-muted">{t.privacy.body}</p>
        <ul class="mt-6 grid gap-3">
          {
            t.privacy.points.map((p) => (
              <li class="rounded-md border border-line bg-surface-2 px-4 py-3 text-sm">{p}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Newsletter — struttura visuale, backend UC 0039 */}
  <section class="border-t border-line py-12">
    <h2 class="text-2xl font-bold tracking-tight">{t.newsletter.title}</h2>
    <p class="mt-2 max-w-2xl text-fg-muted">{t.newsletter.body}</p>
    <form class="mt-6 flex max-w-md flex-wrap gap-2" aria-label={t.newsletter.title}>
      <input
        type="email"
        name="email"
        autocomplete="email"
        placeholder={t.newsletter.placeholder}
        class="min-w-0 flex-1 rounded-md border border-line bg-surface px-3 py-2 text-sm"
      />
      <button
        type="button"
        disabled
        class="rounded-md border border-line bg-surface-2 px-4 py-2 text-sm font-semibold text-fg-muted"
      >
        {t.newsletter.cta}
      </button>
    </form>
    <p class="mt-3 text-sm text-fg-faint">{t.newsletter.note}</p>
  </section>

  {/* FAQ di marca — contenuto machine-readable + FAQPage JSON-LD (UC 0041, GEO) */}
  <FaqSection faq={t.faq} />

  {/* CTA finale */}
  <section class="border-t border-line py-14">
    <h2 class="text-2xl font-bold tracking-tight">{t.finalCta.title}</h2>
    <p class="mt-2 max-w-2xl text-fg-muted">{t.finalCta.body}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={APP_SIGNUP}
        class="rounded-pill bg-accent px-5 py-2.5 font-semibold text-accent-contrast hover:opacity-90"
      >
        {t.finalCta.primary}
      </a>
      <a
        href={brandHref('why', lang)}
        class="rounded-pill border border-line px-5 py-2.5 font-semibold hover:bg-surface-2"
      >
        {t.finalCta.secondary}
      </a>
    </div>
  </section>
</BaseLayout>
