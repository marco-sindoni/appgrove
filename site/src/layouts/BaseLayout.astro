---
// Layout di base della vetrina (UC 0036 + UC 0037): <head> con hreflang +
// x-default, gate di indicizzazione (noindex fino al go-live), brand del design
// system, header con top nav localizzata + selettore lingua, footer arricchito
// (legali · Support · security.txt · newsletter · ©).
import '../styles/global.css'
import LanguageSwitcher from '../components/LanguageSwitcher.tsx'
import NewsletterForm from '../components/NewsletterForm.tsx'
import {
  LOCALES,
  LOCALE_LABELS,
  hreflangAlternates,
  hreflangAlternatesByLocale,
  normalizePath,
  type Locale,
} from '../lib/i18n.ts'
import { brandHref } from '../lib/routes.ts'
import { organizationJsonLd, serializeJsonLd } from '../lib/seo.ts'
import { LEGAL_COMPONENTS } from '../lib/legal.ts'
import { MARKETING } from '../content/marketing/index.ts'
import { APP_LOGIN, APP_SIGNUP, SUPPORT_EMAIL, SECURITY_TXT } from '../lib/links.ts'

interface Props {
  lang: Locale
  title: string
  description?: string
  /** Percorso DOPO il segmento di lingua, es. `/legal/privacy/`. Default `/`. */
  pathWithinLocale?: string
  /**
   * Percorso hreflang PER LINGUA (slug localizzati, UC 0040): quando presente ogni
   * hreflang punta al percorso reale della sua lingua. Assente → stesso percorso per
   * tutte le lingue (corretto per home e legali, che hanno segmento identico).
   */
  hreflangPaths?: Record<Locale, string>
  /** Immagine Open Graph (URL relativa alla radice); assente → nessuna og:image (es. bozze landing). */
  ogImage?: string | null
  /** Identità dell'app per le pagine landing (UC 0038): marcatore usato dal controllo post-build. */
  appId?: string
  /** Dati strutturati Schema.org specifici della pagina (UC 0040); Organization è aggiunta qui. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const { lang, title, description, pathWithinLocale = '/', hreflangPaths, ogImage, appId, jsonLd } = Astro.props
const path = normalizePath(pathWithinLocale)
const t = MARKETING[lang]

// Gate di indicizzazione (#14 54): `noindex` finché SITE_INDEXABLE !== 'true'
// (rimozione = atto operativo al go-live). Default: non indicizzabile. Si legge da
// process.env: il frontmatter Astro gira in Node al build, e import.meta.env NON
// espone le variabili di shell non prefissate PUBLIC_ (corretto in UC 0040, così il
// rebuild go-live `SITE_INDEXABLE=true` ha davvero effetto — coerente con astro.config).
const indexable = process.env.SITE_INDEXABLE === 'true'

const alternates = hreflangPaths ? hreflangAlternatesByLocale(hreflangPaths) : hreflangAlternates(path)
const canonical = new URL(`/${lang}${path}`, Astro.site).toString()

// Selettore lingua: se gli slug sono localizzati, ogni voce punta al percorso della SUA
// lingua (altrimenti si finirebbe su un URL inesistente, es. /en/perche/).
const langOptions = LOCALES.map((loc) => ({
  locale: loc,
  label: LOCALE_LABELS[loc],
  href: hreflangPaths ? `/${loc}${normalizePath(hreflangPaths[loc])}` : `/${loc}${path}`,
}))

const navLinks = [
  { label: t.nav.app, href: `/${lang}/#apps` },
  { label: t.nav.why, href: brandHref('why', lang) },
  { label: t.nav.pricing, href: brandHref('pricing', lang) },
]

// Dati strutturati (UC 0040): Organization su OGNI pagina, più i nodi specifici della
// pagina (BreadcrumbList, SoftwareApplication, FAQPage). `<` neutralizzato in serializzazione.
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
const jsonLdGraph = [organizationJsonLd(new URL('/', Astro.site).toString(), SUPPORT_EMAIL), ...pageJsonLd]

// Misurazione (UC 0040, #14 33), cablata ma SPENTA di default: emessa solo quando
// configurata E il sito è indicizzabile (pre-go-live non si misura nulla di reale).
const plausibleDomain = process.env.PUBLIC_PLAUSIBLE_DOMAIN
const verifyGoogle = process.env.SITE_VERIFICATION_GOOGLE
const verifyBing = process.env.SITE_VERIFICATION_BING

// Etichette brevi dei documenti legali (nomi propri dei documenti, riconoscibili).
const legalLabels: Record<string, string> = {
  privacy: 'Privacy',
  terms: 'Terms',
  refund: 'Refund',
  cookie: 'Cookie',
  subprocessors: 'Sub-processors',
}

const year = new Date().getFullYear()
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · appgrove</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, Astro.site).toString()} />
      ))
    }

    {/* Open Graph / Twitter card (UC 0038): base per l'anteprima social; i dati
        strutturati Schema.org completi arrivano con UC 0040 (SEO tecnico). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="appgrove" />
    <meta property="og:locale" content={lang} />
    <meta property="og:title" content={`${title} · appgrove`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} · appgrove`} />
    {description && <meta name="twitter:description" content={description} />}

    {/* Marcatore delle pagine landing per-app: consente al controllo post-build di
        riconoscerle e verificarne parità 5 lingue + Open Graph (UC 0038). */}
    {appId && <meta name="ag:app-id" content={appId} />}

    {/* Dati strutturati Schema.org (UC 0040): Organization + nodi di pagina. */}
    {
      jsonLdGraph.map((node) => (
        <script type="application/ld+json" set:html={serializeJsonLd(node)} />
      ))
    }

    {/* Verifica proprietà motori (UC 0040): solo se configurata; connessione reale post-go-live. */}
    {verifyGoogle && <meta name="google-site-verification" content={verifyGoogle} />}
    {verifyBing && <meta name="msvalidate.01" content={verifyBing} />}

    {/* Misurazione Plausible (#14 33): solo se configurata E indicizzabile. Analytics
        cookieless, nessun dato personale (postura purista, memoria eu-data-residency). */}
    {indexable && plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-fg">
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
        <a href={`/${lang}/`} class="text-lg font-extrabold tracking-tight">appgrove</a>
        <nav aria-label="Primaria" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          {
            navLinks.map((l) => (
              <a href={l.href} class="text-fg-muted hover:text-fg">
                {l.label}
              </a>
            ))
          }
          <a href={APP_LOGIN} class="text-fg-muted hover:text-fg">{t.nav.login}</a>
          <a
            href={APP_SIGNUP}
            class="rounded-pill bg-accent px-3 py-1.5 font-semibold text-accent-contrast hover:opacity-90"
          >
            {t.nav.signup}
          </a>
          <LanguageSwitcher current={lang} options={langOptions} client:load />
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="text-lg font-extrabold tracking-tight">appgrove</p>
            <p class="mt-2 text-sm text-fg-muted">{t.footer.tagline}</p>
          </div>

          <nav aria-label={t.footer.legalHeading} class="text-sm">
            <p class="mb-2 font-semibold">{t.footer.legalHeading}</p>
            <ul class="flex flex-col gap-1">
              {
                LEGAL_COMPONENTS.map((c) => (
                  <li>
                    <a href={`/${lang}/legal/${c}/`} class="text-fg-muted hover:text-fg">
                      {legalLabels[c] ?? c}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <nav aria-label={t.footer.supportLabel} class="text-sm">
            <p class="mb-2 font-semibold">{t.footer.supportLabel}</p>
            <ul class="flex flex-col gap-1">
              <li>
                <a href={`mailto:${SUPPORT_EMAIL}`} class="text-fg-muted hover:text-fg">
                  {SUPPORT_EMAIL}
                </a>
              </li>
              <li>
                <a href={SECURITY_TXT} class="text-fg-muted hover:text-fg">
                  {t.footer.securityLabel} · security.txt
                </a>
              </li>
            </ul>
          </nav>

          <div class="text-sm">
            <p class="mb-2 font-semibold">{t.footer.newsletterTitle}</p>
            <p class="mb-3 text-fg-muted">{t.footer.newsletterBody}</p>
            {/* Raccolta email attiva (UC 0039): double opt-in via endpoint pubblico
                del core. Isola React con consenso esplicito, campo esca anti-bot ed
                evento Plausible sul successo; riusa i testi di consenso/esito della
                sezione newsletter. */}
            <NewsletterForm
              apiUrl={import.meta.env.PUBLIC_CORE_API_URL ?? ''}
              lang={lang}
              labels={{
                ariaLabel: t.footer.newsletterTitle,
                emailPlaceholder: t.footer.newsletterPlaceholder,
                cta: t.footer.newsletterCta,
                consentLabel: t.newsletter.consentLabel,
                success: t.newsletter.success,
                error: t.newsletter.error,
              }}
              variant="footer"
              client:load
            />
          </div>
        </div>

        <p class="mt-8 border-t border-line pt-6 text-sm text-fg-muted">© {year} {t.footer.rights}</p>
      </div>
    </footer>
  </body>
</html>
